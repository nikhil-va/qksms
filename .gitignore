# Built application files
*.apk
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Intellij
*.iml
.idea/*

# Keystore files
*.jks

# Mac .DS_STORE files
*.DS_STORE

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# Real QKSMS backups and bank SMS tool output (personal data)
backup-*.json
tools/bank-sms/input/
tools/bank-sms/out/

# Release signing config (passwords)
key.properties
*.keystore

# Android Studio "Generate Signed APK/Bundle" output
presentation/*/release/
presentation/release/
